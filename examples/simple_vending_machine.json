{
    "info": {
        "name": "vending_machine_3_dollars",
        "description": "Accepts $1 and $2 coins. Product costs $3. Outputs product and optional $1 change."
    },
    "config": {
        "num_inputs": 2,
        "num_state_vars": 3,
        "num_outputs": 2
    },

    "input_names": [
        {"no_coin": [0, 0]},
        {"inserted_1_dollar": [1, 0]},
        {"inserted_2_dollars": [0, 1]}
    ],

    "state_names": [
        {"zero_dollars": [0, 0, 0]},
        {"one_dollar_stored": [0, 0, 1]},
        {"two_dollars_stored": [0, 1, 0]},
        {"three_dollars_stored": [1, 0, 0]}
    ],

    "output_names": [
        {"nothing": [0, 0]},
        {"dispense_change_only": [0, 1]},
        {"dispense_product_only": [1, 0]},
        {"dispense_product_and_change": [1, 1]}
    ],

    "table": [
        { "input": "no_coin",           "state_t": "zero_dollars",       "state_next": "zero_dollars",       "output": "nothing" },
        { "input": "inserted_1_dollar",  "state_t": "zero_dollars",       "state_next": "one_dollar_stored",  "output": "nothing" },
        { "input": "inserted_2_dollars", "state_t": "zero_dollars",       "state_next": "two_dollars_stored", "output": "nothing" },

        { "input": "no_coin",           "state_t": "one_dollar_stored",  "state_next": "one_dollar_stored",  "output": "nothing" },
        { "input": "inserted_1_dollar",  "state_t": "one_dollar_stored",  "state_next": "two_dollars_stored", "output": "nothing" },
        { "input": "inserted_2_dollars", "state_t": "one_dollar_stored",  "state_next": "three_dollars_stored", "output": "nothing" },

        { "input": "no_coin",           "state_t": "two_dollars_stored",  "state_next": "two_dollars_stored", "output": "nothing" },
        { "input": "inserted_1_dollar",  "state_t": "two_dollars_stored",  "state_next": "three_dollars_stored", "output": "nothing" },
        { "input": "inserted_2_dollars", "state_t": "two_dollars_stored",  "state_next": "three_dollars_stored", "output": "dispense_change_only" },

        { "input": "no_coin",           "state_t": "three_dollars_stored", "state_next": "zero_dollars",       "output": "dispense_product_only" },
        { "input": "inserted_1_dollar",  "state_t": "three_dollars_stored", "state_next": "one_dollar_stored",  "output": "dispense_product_only" },
        { "input": "inserted_2_dollars", "state_t": "three_dollars_stored", "state_next": "two_dollars_stored", "output": "dispense_product_only" }
    ]
}
